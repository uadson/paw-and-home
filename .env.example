# Amazon Associates Tracking ID (ex: yourtag-20)
PUBLIC_AMAZON_AFFILIATE_TAG=pawandhome-20

# GitHub Pages base path
BASE_PATH=/paw-and-home

# Pinterest Telemetry & Ad Tracking (Pinterest Tag ID)
PUBLIC_PINTEREST_TAG_ID=2612345678901

# Pinterest API v5 Automation (OAuth 2.0 Access Token & Target Board ID)
PINTEREST_ACCESS_TOKEN=your_access_token_here
PINTEREST_BOARD_ID=123456789012345678
