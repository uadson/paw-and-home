---
/**
 * Layout Base do Site.
 *
 * Provê a estrutura HTML padrão, SEO head, cabeçalho e rodapé.
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  ogType = 'website',
  schema,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <SeoHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      ogType={ogType}
      schema={schema}
    />
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col font-sans antialiased">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Script de Telemetria de Conversão de Afiliados (Pinterest Tag & Outbound Tracking) -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('a[href*="amazon.com"]').forEach((link) => {
          link.addEventListener('click', (event) => {
            const anchor = event.currentTarget;
            const asin = anchor.dataset.asin || '';
            const productName = anchor.dataset.productName || anchor.innerText.trim();

            if (typeof window !== 'undefined' && typeof window.pintrk === 'function') {
              window.pintrk('track', 'lead', {
                lead_type: 'Amazon Outbound Click',
                asin: asin,
                product_name: productName,
                currency: 'USD',
                value: 0
              });
            }
          });
        });
      });
    </script>
  </body>
</html>
