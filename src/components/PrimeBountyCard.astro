---
/**
 * Card de Monetização do Programa de Recompensa (Amazon Prime Bounty Program).
 *
 * Incentiva os visitantes a ativarem o teste gratuito de 30 dias do Amazon Prime,
 * gerando receita fixa de bounty (US$ 3 a 5) mesmo sem compra de produtos.
 */
import { buildPrimeTrialUrl, getAffiliateRel } from '../utils/affiliate';

interface Props {
  amazonTag?: string;
  className?: string;
}

const { amazonTag, className = '' } = Astro.props;
const primeUrl = buildPrimeTrialUrl(amazonTag);
const relAttr = getAffiliateRel();
---

<aside 
  class={`my-8 bg-gradient-to-br from-sky-900 via-slate-900 to-indigo-950 text-white rounded-2xl p-5 sm:p-6 border border-sky-700/40 shadow-md ${className}`}
  aria-label="Amazon Prime Free Trial Offer"
>
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="space-y-1.5 max-w-xl">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-sky-500/20 border border-sky-400/30 text-sky-300 text-[11px] font-bold uppercase tracking-wider">
        <svg class="w-3.5 h-3.5 fill-sky-400" viewBox="0 0 24 24">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
        Amazon Prime Perk
      </div>
      <h4 class="text-lg sm:text-xl font-extrabold text-white leading-snug">
        Need Your Gear Delivered Tomorrow?
      </h4>
      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-normal">
        Most products in this review qualify for fast, free 1-day or 2-day delivery with Amazon Prime. Activate a <strong>30-Day Free Trial</strong> today and cancel anytime with zero commitment.
      </p>
    </div>

    <div class="shrink-0 w-full sm:w-auto text-center sm:text-right">
      <a 
        href={primeUrl}
        target="_blank"
        rel={relAttr}
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 active:scale-98 text-slate-950 font-bold text-xs sm:text-sm shadow-sm transition-all"
      >
        <span>Try Prime 30-Day Free</span>
        <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <span class="block text-[10px] text-slate-400 mt-1.5 font-light">
        Eligible for new US accounts. Cancel anytime.
      </span>
    </div>
  </div>
</aside>
