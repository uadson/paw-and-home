---
/**
 * Componente de Card de Produto Otimizado para Alta Conversão de Afiliados.
 *
 * Apresenta o produto com badges de destaque, notas, prós/contras,
 * link canônico higienizado com tag de associado e marcação Schema.org.
 */
import { buildAmazonUrl, getAffiliateRel } from '../utils/affiliate';
import { buildProductSchema } from '../utils/seo';

interface Props {
  name: string;
  tagline?: string;
  badge?: string;
  rank?: number;
  image: string;
  imageAlt?: string;
  asin: string;
  brand?: string;
  rating?: number;
  reviewCount?: number;
  pros?: string[];
  cons?: string[];
  verdict?: string;
  specs?: Record<string, string>;
  ctaText?: string;
  amazonTag?: string;
  showSchema?: boolean;
}

const {
  name,
  tagline,
  badge,
  rank,
  image,
  imageAlt = name,
  asin,
  brand,
  rating = 4.7,
  reviewCount = 1000,
  pros = [],
  cons = [],
  verdict,
  specs,
  ctaText = 'View on Amazon',
  amazonTag,
  showSchema = false,
} = Astro.props;

const amazonUrl = buildAmazonUrl(asin, amazonTag);
const relAttr = getAffiliateRel();

// Schema.org para o produto caso habilitado
const productSchema = showSchema ? buildProductSchema({
  name,
  description: verdict || tagline || name,
  image,
  asin,
  rating,
  reviewCount,
  brand,
}) : null;
---

<article 
  class="bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md transition-shadow duration-200 overflow-hidden my-8"
  id={`product-${asin}`}
>
  {showSchema && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(productSchema)}
    />
  )}

  <!-- Cabeçalho do Card com Badges -->
  {(badge || rank) && (
    <div class="bg-gradient-to-r from-slate-900 to-slate-800 text-white px-5 py-2.5 flex items-center justify-between">
      <div class="flex items-center gap-2">
        {rank && (
          <span class="w-6 h-6 rounded-full bg-amber-500 text-slate-950 font-bold text-xs flex items-center justify-center">
            #{rank}
          </span>
        )}
        {badge && (
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-300">
            {badge}
          </span>
        )}
      </div>
      {brand && (
        <span class="text-xs text-slate-300 font-medium">
          Brand: <strong class="text-white">{brand}</strong>
        </span>
      )}
    </div>
  )}

  <div class="p-5 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
      <!-- Imagem do Produto -->
      <div class="md:col-span-5 flex flex-col items-center justify-center">
        <a 
          href={amazonUrl} 
          target="_blank" 
          rel={relAttr}
          class="block relative group w-full max-w-[280px] aspect-square rounded-xl overflow-hidden bg-slate-50 border border-slate-100 p-4 flex items-center justify-center hover:opacity-95 transition-opacity"
        >
          <img 
            src={image} 
            alt={imageAlt}
            loading="lazy"
            decoding="async"
            width="280"
            height="280"
            class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
          />
        </a>

        <!-- Nota de Avaliação -->
        <div class="mt-3 flex items-center gap-2 text-sm text-slate-600">
          <div class="flex text-amber-400" aria-label={`Rating: ${rating} out of 5 stars`}>
            {Array.from({ length: 5 }).map((_, i) => (
              <svg 
                class={`w-4 h-4 ${i < Math.floor(rating) ? 'fill-amber-400' : 'fill-slate-200'}`} 
                viewBox="0 0 20 20"
              >
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <span class="font-bold text-slate-900">{rating.toFixed(1)}</span>
          <span class="text-xs text-slate-500">({reviewCount.toLocaleString()} ratings)</span>
        </div>
      </div>

      <!-- Detalhes do Produto -->
      <div class="md:col-span-7 flex flex-col justify-between">
        <div>
          <h3 class="text-xl sm:text-2xl font-bold text-slate-900 leading-snug">
            <a 
              href={amazonUrl}
              target="_blank"
              rel={relAttr}
              class="hover:text-amber-600 transition-colors"
            >
              {name}
            </a>
          </h3>

          {tagline && (
            <p class="text-sm font-medium text-slate-500 mt-1 italic">
              {tagline}
            </p>
          )}

          {verdict && (
            <p class="mt-3 text-slate-600 text-sm leading-relaxed">
              {verdict}
            </p>
          )}

          <!-- Especificações Chave (se houver) -->
          {specs && (
            <div class="mt-4 grid grid-cols-2 gap-2 text-xs bg-slate-50 p-3 rounded-lg border border-slate-100">
              {Object.entries(specs).map(([label, value]) => (
                <div>
                  <span class="text-slate-500 block font-normal">{label}:</span>
                  <span class="text-slate-800 font-semibold">{value}</span>
                </div>
              ))}
            </div>
          )}

          <!-- Prós e Contras -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4 pt-4 border-t border-slate-100">
            {pros.length > 0 && (
              <div class="bg-emerald-50/50 rounded-xl p-3 border border-emerald-100">
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 flex items-center gap-1 mb-2">
                  <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  What We Like
                </span>
                <ul class="text-xs text-slate-700 space-y-1.5">
                  {pros.map((pro) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-emerald-600 font-bold shrink-0">•</span>
                      <span>{pro}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {cons.length > 0 && (
              <div class="bg-rose-50/50 rounded-xl p-3 border border-rose-100">
                <span class="text-xs font-bold uppercase tracking-wider text-rose-800 flex items-center gap-1 mb-2">
                  <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                  Worth Considering
                </span>
                <ul class="text-xs text-slate-700 space-y-1.5">
                  {cons.map((con) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-rose-600 font-bold shrink-0">•</span>
                      <span>{con}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>

        <!-- Botão CTA de Afiliado com Visual Amazon Premium -->
        <div class="mt-6 pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="text-xs text-slate-500 text-center sm:text-left">
            <span class="font-medium text-slate-700">Check current price & offers</span>
            <span class="block text-[11px] text-slate-400">Prime shipping available on eligible orders</span>
          </div>

          <a 
            href={amazonUrl}
            target="_blank"
            rel={relAttr}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-bold text-sm rounded-xl shadow-sm hover:shadow-md transition-all active:scale-98"
          >
            <span>{ctaText}</span>
            <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</article>
