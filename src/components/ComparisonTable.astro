---
/**
 * Componente de Tabela Comparativa de Produtos de Alta Conversão.
 *
 * Apresenta um resumo comparativo "Top Picks at a Glance" ideal para ser posicionado
 * no início de artigos de afiliados para capturar leitores prontos para comprar.
 */
import { buildAmazonUrl, getAffiliateRel } from '../utils/affiliate';

export interface ComparisonProduct {
  rank?: number;
  name: string;
  badge?: string;
  rating?: number;
  image: string;
  asin: string;
  highlight: string;
  amazonTag?: string;
}

interface Props {
  title?: string;
  products: ComparisonProduct[];
}

const {
  title = 'Quick Comparison: Top Picks at a Glance',
  products = [],
} = Astro.props;

const relAttr = getAffiliateRel();
---

<div class="my-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
  {title && (
    <div class="bg-slate-900 text-white px-5 py-3.5 flex items-center justify-between">
      <h3 class="font-bold text-sm sm:text-base flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {title}
      </h3>
      <span class="text-[11px] text-slate-400 font-medium hidden sm:inline">Updated for 2026</span>
    </div>
  )}

  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs sm:text-sm text-slate-700">
      <thead class="bg-slate-50 text-slate-500 uppercase text-[10px] tracking-wider border-b border-slate-200">
        <tr>
          <th scope="col" class="py-3 px-4">Product</th>
          <th scope="col" class="py-3 px-4">Award</th>
          <th scope="col" class="py-3 px-4">Key Highlight</th>
          <th scope="col" class="py-3 px-4 text-center">Rating</th>
          <th scope="col" class="py-3 px-4 text-right">Amazon</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {products.map((item) => {
          const url = buildAmazonUrl(item.asin, item.amazonTag);
          return (
            <tr class="hover:bg-amber-50/30 transition-colors">
              <td class="py-3.5 px-4">
                <a 
                  href={url} 
                  target="_blank" 
                  rel={relAttr}
                  class="flex items-center gap-3 font-semibold text-slate-900 hover:text-amber-600 transition-colors"
                >
                  <img 
                    src={item.image} 
                    alt={item.name}
                    class="w-12 h-12 object-contain rounded-lg border border-slate-100 bg-white p-1 shrink-0"
                    loading="lazy"
                  />
                  <span class="line-clamp-2 max-w-[200px] sm:max-w-xs">{item.name}</span>
                </a>
              </td>
              <td class="py-3.5 px-4 whitespace-nowrap">
                {item.badge ? (
                  <span class="inline-block px-2 py-0.5 rounded-full bg-amber-100 text-amber-900 text-[11px] font-bold">
                    {item.badge}
                  </span>
                ) : (
                  <span class="text-slate-400">—</span>
                )}
              </td>
              <td class="py-3.5 px-4 text-slate-600 text-xs">
                {item.highlight}
              </td>
              <td class="py-3.5 px-4 text-center whitespace-nowrap">
                <span class="font-bold text-slate-900">{item.rating?.toFixed(1) || '4.8'}</span>
                <span class="text-amber-500 ml-0.5">★</span>
              </td>
              <td class="py-3.5 px-4 text-right whitespace-nowrap">
                <a 
                  href={url}
                  target="_blank"
                  rel={relAttr}
                  class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs shadow-2xs hover:shadow-xs transition-all"
                >
                  <span>Check Price</span>
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>
