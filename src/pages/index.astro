---
/**
 * Página Inicial (Homepage) do Site de Afiliados.
 *
 * Apresenta curadoria editorial, categorias principais, guias em destaque
 * e métricas de confiança para o consumidor americano.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
const featuredArticle = sortedArticles.find((a) => a.data.featured) || sortedArticles[0];
---

<BaseLayout
  title="Paw & Home Guides - Expert Buying Guides & Reviews for US Homes"
  description="Discover tested, high-converting product reviews and buying guides in Pet Care and Home Organization. Unbiased recommendations with direct Amazon links."
>
  <!-- Hero Section com Proposta de Valor Forte -->
  <section class="bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white py-16 sm:py-24 border-b border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-semibold mb-6 border border-amber-500/30">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        <span>Independent Research & Direct Amazon Deals</span>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight max-w-4xl mx-auto leading-tight">
        Smarter Choices for Your <span class="text-amber-400">Pets & Home</span>
      </h1>

      <p class="mt-6 text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto font-light leading-relaxed">
        We spend dozens of hours researching specifications, real user reviews, and recall databases so you can shop with 100% confidence.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-4 text-xs text-slate-400">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          No Sponsored Biases
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          FTC Compliant & Transparent
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Amazon Prime Verified Deals
        </span>
      </div>
    </div>
  </section>

  <!-- Container Principal -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <AffiliateDisclosure variant="banner" />

    <!-- Guia em Destaque (Featured Hero Guide) -->
    {featuredArticle && (
      <section class="my-10" id="featured">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-black text-slate-900 flex items-center gap-2">
            <span class="w-2.5 h-6 bg-amber-500 rounded-sm"></span>
            Editor's Featured Guide
          </h2>
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-600 bg-amber-50 px-2.5 py-1 rounded border border-amber-200">
            Must-Read
          </span>
        </div>

        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden hover:shadow-lg transition-all duration-300 grid grid-cols-1 md:grid-cols-12 group">
          <div class="md:col-span-6 overflow-hidden bg-slate-100 flex items-center justify-center max-h-[420px]">
            <img 
              src={featuredArticle.data.heroImage || 'https://images.unsplash.com/photo-1548767797-d8c844163c4c?w=1200&auto=format&fit=crop&q=80'} 
              alt={featuredArticle.data.heroImageAlt || featuredArticle.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="eager"
            />
          </div>
          <div class="md:col-span-6 p-6 sm:p-10 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 text-xs font-semibold text-amber-700 uppercase tracking-wider mb-2">
                <span>{featuredArticle.data.category}</span>
                <span>•</span>
                <span>Top Ranked</span>
              </div>

              <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-950 group-hover:text-amber-600 transition-colors leading-tight">
                <a href={`${baseUrl}/articles/${featuredArticle.id.replace(/\.(md|mdx)$/, '')}`}>
                  {featuredArticle.data.title}
                </a>
              </h3>

              <p class="mt-4 text-slate-600 text-sm sm:text-base leading-relaxed">
                {featuredArticle.data.description}
              </p>
            </div>

            <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs text-slate-500">
                By <strong class="text-slate-800">{featuredArticle.data.author}</strong>
              </span>

              <a 
                href={`${baseUrl}/articles/${featuredArticle.id.replace(/\.(md|mdx)$/, '')}`}
                class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-slate-900 text-white font-semibold text-xs hover:bg-amber-500 hover:text-slate-950 transition-all shadow-xs"
              >
                <span>Read Full Review</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Grade de Todos os Artigos -->
    <section class="my-14" id="buying-guides">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-black text-slate-900 flex items-center gap-2">
            <span class="w-2.5 h-6 bg-slate-900 rounded-sm"></span>
            Latest Tested Guides
          </h2>
          <p class="text-xs text-slate-500 mt-1">Updated weekly with verified buyer sentiment and pricing checks</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedArticles.map((article) => {
          const slug = article.id.replace(/\.(md|mdx)$/, '');
          return (
            <article class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-2xs hover:shadow-md transition-shadow flex flex-col justify-between group">
              <div>
                <a href={`${baseUrl}/articles/${slug}`} class="block overflow-hidden aspect-video bg-slate-100">
                  <img 
                    src={article.data.heroImage} 
                    alt={article.data.heroImageAlt || article.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </a>
                <div class="p-5">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-amber-700 block mb-1">
                    {article.data.category}
                  </span>
                  <h3 class="font-bold text-slate-900 text-lg leading-snug group-hover:text-amber-600 transition-colors">
                    <a href={`${baseUrl}/articles/${slug}`}>
                      {article.data.title}
                    </a>
                  </h3>
                  <p class="text-xs text-slate-600 mt-2 line-clamp-3 leading-relaxed">
                    {article.data.description}
                  </p>
                </div>
              </div>

              <div class="px-5 pb-5 pt-2 flex items-center justify-between border-t border-slate-100 text-xs text-slate-500">
                <span>{new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(new Date(article.data.publishDate))}</span>
                <a href={`${baseUrl}/articles/${slug}`} class="font-semibold text-slate-900 group-hover:text-amber-600 flex items-center gap-1">
                  Read guide <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Por que confiar em nós (Trust & Authority E-E-A-T) -->
    <section class="my-16 bg-white rounded-3xl p-8 sm:p-12 border border-slate-200/90 shadow-2xs">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-600">Our Review Methodology</span>
        <h2 class="text-3xl font-extrabold text-slate-950 mt-1">Why Americans Trust Our Buying Advice</h2>
        <p class="text-slate-600 text-sm mt-3 leading-relaxed">
          We don't accept free manufacturer review samples in exchange for positive scores. Our picks are backed by independent material analysis, decibel noise meters, veterinary consultations, and aggregated verified customer feedback.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-8 pt-8 border-t border-slate-100">
        <div class="space-y-2">
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
            01
          </div>
          <h4 class="font-bold text-slate-900 text-sm">Real Testing Data</h4>
          <p class="text-xs text-slate-500 leading-relaxed">
            Every product in our guides is tested for durability, noise levels, and ease of routine cleaning.
          </p>
        </div>

        <div class="space-y-2">
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
            02
          </div>
          <h4 class="font-bold text-slate-900 text-sm">FTC Transparent</h4>
          <p class="text-xs text-slate-500 leading-relaxed">
            We clearly state affiliate relationships on every page. You never pay a penny extra when buying through our links.
          </p>
        </div>

        <div class="space-y-2">
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
            03
          </div>
          <h4 class="font-bold text-slate-900 text-sm">Dynamic Price Alerts</h4>
          <p class="text-xs text-slate-500 leading-relaxed">
            We don't display stale prices. We route directly to official Amazon listings where current coupons and Prime deals apply.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
